{
  "version": 1,
  "description": "Local Git push audit policy for Proxmark3-GUI-NEW. Unknown files are never allowed automatically.",
  "allow_extensions": [
    ".cpp", ".h", ".c", ".pro", ".pri", ".ui", ".qrc",
    ".ts", ".qm", ".md", ".txt", ".json", ".ini",
    ".sh", ".ps1", ".bat", ".cmd", ".py", ".js", ".rs",
    ".svg", ".ico", ".ttf", ".woff", ".woff2", ".wav",
    ".yml", ".yaml", ".gitignore", ".gitattributes"
  ],
  "allow_paths": [
    "resources/felica/station_codes.csv",
    "resources/felica/station_codes_legacy.csv",
    "docs/images/",
    ".githooks/",
    "resources/icons/"
  ],
  "block_paths": [
    "artifacts/",
    "dist/",
    "backup/",
    "backups/",
    ".proxmark3/",
    "data/",
    "pasmo_dump.json",
    "pasmo_card.json",
    "pasmo_history.csv",
    "pasmo_gate_history.csv",
    "GUIsettings.ini",
    "*.dump",
    "*.session.log",
    "*.log",
    "*.bak",
    "*.tmp",
    "*.pdb"
  ],
  "review_extensions": [
    ".exe", ".dll", ".zip", ".7z", ".rar", ".tar", ".gz",
    ".pdf", ".bin", ".dat", ".img", ".iso", ".woff2"
  ],
  "review_paths": [
    "data/",
    "samples/",
    "captures/"
  ],
  "content_block_patterns": [
    "(?i)BEGIN\\s+(RSA\\s+|EC\\s+|OPENSSH\\s+|PGP\\s+)?PRIVATE\\s+KEY",
    "gh[pousr]_[A-Za-z0-9]{20,}",
    "github_pat_[A-Za-z0-9_]{20,}",
    "AKIA[0-9A-Z]{16}",
    "(?i)[A-Z]:\\\\Users\\\\[A-Za-z0-9._-]+",
    "(?i)E:\\\\Opencode_project",
    "Opencode_project[_]Backup",
    "\"idm\"\\s*:\\s*\"[0-9A-Fa-f]{16}\""
  ],
  "content_review_patterns": [
    "\\bCOM[0-9]{1,3}\\b",
    "(?:[0-9A-Fa-f]{2}\\s+){40,}",
    "(?i)card[_-]?number\\s*[:=]\\s*[0-9]{12,}"
  ]
}
